{
  "name": "jamgyeol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:scenes && npm run test:narrative && npm run test:long-dreams && npm run test:semantic-understanding && npm run test:result && npm run test:comparison && npm run test:round2 && npm run test:api",
    "test:scenes": "node --no-warnings --experimental-strip-types scripts/verify-scene-analysis.mjs",
    "test:narrative": "node --no-warnings --experimental-strip-types scripts/verify-narrative-pipeline.mjs",
    "test:api": "node --no-warnings --experimental-strip-types scripts/verify-narrative-api.mjs",
    "test:result": "node --no-warnings --experimental-strip-types scripts/verify-result-presentation.mjs",
    "test:comparison": "node --no-warnings --experimental-strip-types scripts/verify-dream-comparison.mjs",
    "test:round2": "node --no-warnings --experimental-strip-types scripts/verify-round2-regressions.mjs",
    "compare:dream-pipeline:live": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/compare-dream-pipelines.mjs --live",
    "compare:dream-pipeline:round2:live": "node --env-file-if-exists=.env.local --no-warnings --experimental-strip-types scripts/compare-dream-pipelines.mjs --round2 --live",
    "validate:dreams": "node scripts/validate-dream-dictionary.mjs",
    "check:copy": "node scripts/check-korean-copy.mjs",
    "check:duplicates": "node scripts/check-dream-duplicates.mjs",
    "verify:grounding": "node --no-warnings --experimental-strip-types scripts/verify-input-grounding.mjs",
    "verify:relations": "node --no-warnings --experimental-strip-types scripts/verify-entity-relations.mjs",
    "verify:transformations": "node --no-warnings --experimental-strip-types scripts/verify-transformations.mjs",
    "verify:interpretation-facts": "node --no-warnings --experimental-strip-types scripts/verify-interpretation-facts.mjs",
    "verify:content": "node --no-warnings --experimental-strip-types scripts/verify-dream-content.mjs",
    "verify:grounded-reading": "node --no-warnings --experimental-strip-types scripts/verify-grounded-reading.mjs",
    "test:long-dreams": "node --no-warnings --experimental-strip-types scripts/verify-long-dreams.mjs",
    "test:semantic-understanding": "node --no-warnings --experimental-strip-types scripts/verify-semantic-understanding.mjs"
  },
  "dependencies": {
    "next": "16.2.10",
    "openai": "^6.45.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
