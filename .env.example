# 서버 전용 키입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
OPENAI_API_KEY=

# 배포 사이트의 공개 기준 주소입니다. 예: https://jamgyeol.kr
SITE_URL=https://jamgyeol.example.com
CONTACT_EMAIL=contact@jamgyeol.example.com

# 공개 측정 ID입니다. 비워두면 방문 통계 스크립트를 전혀 불러오지 않습니다.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search Console의 HTML 태그 인증 문자열(content 값)입니다.
GOOGLE_SITE_VERIFICATION=

# 선택 사항: 미설정 시 서버 코드의 기본 설정을 사용합니다.
OPENAI_DREAM_MODEL=gpt-4o-mini

# 꿈풀이 운영 모드: ai-first(기본), hybrid, dictionary-only
DREAM_INTERPRETATION_MODE=ai-first
DREAM_MAX_OUTPUT_TOKENS=2400
DREAM_REQUEST_TIMEOUT_MS=30000
DREAM_CONTEXT_ENTRY_LIMIT=8

# 운영 환경의 영속 사용량 저장소입니다. 두 값을 함께 설정하세요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IP와 꿈 내용 해시에 사용하는 별도 비밀 문자열입니다.
RATE_LIMIT_HASH_SALT=

# 비용 보호 한도 (UTC 기준)
DREAM_RATE_LIMIT_PER_MINUTE=2
DREAM_RATE_LIMIT_PER_HOUR=5
DREAM_RATE_LIMIT_PER_DAY=10
DREAM_GLOBAL_DAILY_LIMIT=50
DREAM_CACHE_TTL_SECONDS=300
